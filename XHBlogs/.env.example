# 复制本文件为 .env.local 后填写（.env.local 已被 .gitignore 忽略，不会被提交）
# 全部留空也能本地预览，只是对应功能不可用。线上请在 Vercel → Settings → Environment Variables 中配置同名变量。

# 右下角桌宠的对话（Google AI Studio 申请）
GEMINI_API_KEY=

# Gitalk 评论登录：GitHub OAuth App 的 Client Secret（不要再写进 siteConfig.ts）
GITALK_CLIENT_SECRET=
# 可选：覆盖 siteConfig.gitalkConfig.clientID
GITALK_CLIENT_ID=

# 书影音页（/media）添加电影 / 电视剧时用的 TMDB（https://www.themoviedb.org/settings/api 申请）
# 填 v3 的 API Key 或 v4 的 Read Access Token 都可以；线上也可以不配，在网页后台的书影音与密钥板块里填（加密保存）
TMDB_API_KEY=
# 可选：本地服务器访问 TMDB / Bangumi 时走的代理。Node 不会自动走系统代理（Clash、v2rayN 等），
# 国内网络下填 TMDB Key 一直转圈 / 提示连不上时，填代理软件的 HTTP 端口，例如 http://127.0.0.1:7890
HTTPS_PROXY=
# 可选：访问不了 TMDB 时换成反代地址（默认 https://api.themoviedb.org 与 https://image.tmdb.org）
TMDB_API_BASE=
TMDB_IMAGE_BASE=

# 可选：Bangumi Access Token（https://next.bgm.tv/demo/access-token 生成），登录后书影音的 Bangumi 搜索能搜到全部条目
# 也可以在书影音页添加时，Bangumi 搜索下面点「登录 Bangumi」直接填
BANGUMI_ACCESS_TOKEN=

# 可选：data.gov.sg 的 API Key（https://data.gov.sg 免费申请）。首页天气不填也能用，填了只是提高请求频率上限；
# 天气每 20 分钟才更新一轮，一般用不到。城市、区域在 siteConfig.ts 的 weather 里设置
DATA_GOV_SG_API_KEY=

# 站点正式地址，用于 sitemap.xml、robots.txt 和分享卡片（留空时依次读取 public/CNAME、Vercel 生产域名）
SITE_URL=

# 设为 true 可关闭 Next.js 图片优化（例如 Vercel 图片优化额度用尽时）
IMAGE_UNOPTIMIZED=

# —— 网页后台（/admin），详细步骤见 docs/ADMIN.md ——
# 管理员密码：设了才能用后台；线上请设一个长一点的
ADMIN_PASSWORD=
# 后台保存时提交到哪个仓库（GitHub Fine-grained token，只给这个仓库 Contents 读写 + Commit statuses 只读）
# 本地开发时这三项可以不填：后台直接读写电脑上的文件
GITHUB_TOKEN=
# 用户名/仓库名
GITHUB_REPO=
# Vercel 部署的分支，默认 main
GITHUB_BRANCH=
# 博客在仓库里的文件夹，默认 XHBlogs；博客就在仓库根目录时填 .
GITHUB_BLOG_DIR=
# 可选：加密后台保存的密钥（TMDB / Bangumi / Gemini）用；不填就用 ADMIN_PASSWORD（那样改密码后要重填密钥）
ADMIN_SECRETS_KEY=

# 可选：网易云接口地址（默认 https://music.163.com），服务器连不上时换成自己的反代
NETEASE_API_BASE=
