# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# 端到端测试（npm run test:e2e）：单独的构建目录、报告，以及测试期间临时放进来的内容
/.next-e2e/
/test-results/
/playwright-report/
/posts/zz-e2e-*
/chatters/zz-e2e-*

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 本地歌单由 scripts/build-music-manifest.mjs 自动生成
/public/music/playlist.json
/public/music/_covers/
/public/music/_lyrics/
/.e2e-admin-root

# 自己的服务器上自动重建（scripts/self-host/rebuild.mjs，见 docs/DEPLOY-BAOTA.md）：状态、锁、日志、构建中 / 换下来的目录
/.rebuild-status.json
/.rebuild.lock
/.rebuild.pending
/.rebuild.log
/.rebuild.log.old
/.next-staging/
/.next-old/
# pm2 的日志（ecosystem.config.cjs）
/logs/
