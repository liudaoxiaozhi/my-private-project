# 复制本文件为 .env.local 后填写（.env.local 已被 .gitignore 忽略，不会被提交）
# 全部留空也能本地预览，只是对应功能不可用。线上请在 Vercel → Settings → Environment Variables 中配置同名变量。

# 赛博猫「煤球」对话（Google AI Studio 申请）
GEMINI_API_KEY=

# Gitalk 评论登录：GitHub OAuth App 的 Client Secret（不要再写进 siteConfig.ts）
GITALK_CLIENT_SECRET=
# 可选：覆盖 siteConfig.gitalkConfig.clientID
GITALK_CLIENT_ID=

# 和风天气组件
QWEATHER_KEY=
