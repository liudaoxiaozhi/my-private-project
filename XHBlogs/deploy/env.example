# deploy/env.example —— 自己的服务器（宝塔）上的配置模板，步骤见 docs/DEPLOY-BAOTA.md
#
# 用法：复制成项目目录（XHBlogs/）下的 .env.production.local，再按下面的说明填：
#   cp deploy/env.example .env.production.local
# .env.production.local 已被 .gitignore 忽略，不会被提交，也不会被 scripts/self-host/backup.sh 推到 GitHub。
# next build 和 next start 都会自动读它；改完之后在后台点「立即重建」（或 pm2 reload xhblogs）才生效。

# —— 必填 ——

# 后台（/admin）的管理员密码：设一个长一点的
ADMIN_PASSWORD=
# 强烈建议：加密后台保存的密钥（TMDB / Bangumi / Gemini）和账单（data/bills.json）用的钥匙。
# 一串随机长字符（比如在终端里执行 openssl rand -base64 32 生成），设好后不要再改，并另外抄一份保存好。
# 不填就用 ADMIN_PASSWORD——那样改管理员密码后密钥要重填、旧账单也会解不开。
# 和 Vercel 上用的必须是同一个值，否则那边保存的密钥 / 账单在这边解不开。
ADMIN_SECRETS_KEY=

# 后台直接读写服务器上的文件（不经过 GitHub）
ADMIN_STORAGE=local
# 项目目录（XHBlogs 文件夹的完整路径）；不填默认就是项目目录
ADMIN_LOCAL_ROOT=/www/wwwroot/xhblogs/XHBlogs
# 后台保存后自动重新构建网站，大约 1~3 分钟后上线
SELF_HOST_REBUILD=1
# 构建好之后怎么重启网站（默认就是这一条，用 ecosystem.config.cjs 启动的不用改）
REBUILD_RESTART_CMD=pm2 reload xhblogs --update-env
# 可选：最后一次保存后等多久开始构建（毫秒，默认 10000）。连着改好几处时只构建一次
REBUILD_DEBOUNCE_MS=

# 网站在宝塔的 nginx 反向代理后面：相信 nginx 传来的访客 IP（X-Real-IP / X-Forwarded-For）和域名（X-Forwarded-Host）。
# 登录限流按真实 IP 计算、后台的同源检查才对得上。前面还有一层 CDN（比如 Cloudflare）时填 2。
# 只有网站只监听 127.0.0.1（ecosystem.config.cjs 已经这样设了）、外面只能经过 nginx 访问时才能开
TRUST_PROXY=1

# 站点正式地址：sitemap.xml、robots.txt、分享卡片用
SITE_URL=https://your-domain.com

# —— 可选（和 .env.example 里的一样，不填对应功能不可用） ——

# 右下角桌宠的对话（Google AI Studio 申请）；也可以在后台「书影音与密钥」里填（加密保存）
GEMINI_API_KEY=
# 书影音页添加电影 / 电视剧用的 TMDB Key；也可以在后台填
TMDB_API_KEY=
# 访问不了 TMDB 时换成反代地址（海外服务器一般不用填）
TMDB_API_BASE=
TMDB_IMAGE_BASE=
# Bangumi Access Token：书影音的 Bangumi 搜索能搜到全部条目；也可以在后台填
BANGUMI_ACCESS_TOKEN=
# data.gov.sg 的 API Key：首页天气，不填也能用
DATA_GOV_SG_API_KEY=
# 网易云接口地址（默认 https://music.163.com）；服务器连不上网易云时换成自己的反代
NETEASE_API_BASE=
# 可选：单独的登录签名密钥；不填由 ADMIN_PASSWORD 派生（改密码后所有设备都要重新登录）
ADMIN_SESSION_SECRET=

# 不用填：GITHUB_TOKEN / GITHUB_REPO（那是 Vercel 上后台提交到 GitHub 用的；这里 ADMIN_STORAGE=local 优先）。
# 服务器上的内容备份到 GitHub 用 scripts/self-host/backup.sh（走服务器的部署密钥）。
