# 复制本文件为 .env.local 后填写（.env.local 已被 .gitignore 忽略，不会被提交）
# 全部留空也能本地预览，只是对应功能不可用。线上请在 Vercel → Settings → Environment Variables 中配置同名变量。

# 右下角桌宠的对话（Google AI Studio 申请）
GEMINI_API_KEY=

# Gitalk 评论登录：GitHub OAuth App 的 Client Secret（不要再写进 siteConfig.ts）
GITALK_CLIENT_SECRET=
# 可选：覆盖 siteConfig.gitalkConfig.clientID
GITALK_CLIENT_ID=

# 追番页添加电影 / 电视剧时用的 TMDB（https://www.themoviedb.org/settings/api 申请）
# 填 v3 的 API Key 或 v4 的 Read Access Token 都可以；只在本地预览时使用
TMDB_API_KEY=
# 可选：本地服务器访问 TMDB / Bangumi 时走的代理。Node 不会自动走系统代理（Clash、v2rayN 等），
# 国内网络下填 TMDB Key 一直转圈 / 提示连不上时，填代理软件的 HTTP 端口，例如 http://127.0.0.1:7890
HTTPS_PROXY=
# 可选：访问不了 TMDB 时换成反代地址（默认 https://api.themoviedb.org 与 https://image.tmdb.org）
TMDB_API_BASE=
TMDB_IMAGE_BASE=

# 可选：Bangumi Access Token（https://next.bgm.tv/demo/access-token 生成），登录后追番搜索能搜到全部条目
# 也可以在追番页「动画 · Bangumi」搜索下面点「登录 Bangumi」直接填
BANGUMI_ACCESS_TOKEN=

# 和风天气组件
QWEATHER_KEY=

# 站点正式地址，用于 sitemap.xml、robots.txt 和分享卡片（留空时依次读取 public/CNAME、Vercel 生产域名）
SITE_URL=

# 设为 true 可关闭 Next.js 图片优化（例如 Vercel 图片优化额度用尽时）
IMAGE_UNOPTIMIZED=
